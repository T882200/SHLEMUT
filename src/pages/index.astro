---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products', ({ data }) => data.status === 'published');
const featuredProducts = allProducts.filter((p) => p.data.featured);
---

<BaseLayout title="Home">
  <!-- ============================================
       HERO SECTION
       ============================================ -->
  <section class="relative overflow-hidden py-24 md:py-32 lg:py-40">
    <div class="container-wide">
      <div class="max-w-4xl">
        <!-- Eyebrow -->
        <p class="text-sm font-semibold uppercase tracking-widest mb-6 fade-in-up" style="color: var(--color-accent);">
          Premium Digital Assets
        </p>

        <!-- Headline with kinetic typography effect -->
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-none tracking-tight fade-in-up" style="color: var(--color-text);">
          Fonts &<br />
          <span class="inline-block relative">
            <span id="hero-word" class="inline-block transition-all duration-500" style="color: var(--color-accent);">Scripts</span>
          </span><br />
          for Designers
        </h1>

        <!-- Subtitle -->
        <p class="mt-8 text-lg md:text-xl max-w-2xl fade-in-up" style="color: var(--color-text-muted); line-height: 1.7;">
          Carefully crafted typefaces and InDesign automation scripts.
          Built by designers, for designers who demand precision.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 mt-10 fade-in-up">
          <a href="/SHLEMUT/shop/" class="btn btn-primary text-base px-8 py-4">
            Browse Shop
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="/SHLEMUT/about/" class="btn btn-secondary text-base px-8 py-4">
            Learn More
          </a>
        </div>
      </div>
    </div>

    <!-- Decorative background element -->
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none opacity-[0.03] select-none overflow-hidden hidden lg:block" aria-hidden="true">
      <span class="absolute -right-20 top-1/2 -translate-y-1/2 text-[28rem] font-bold leading-none" style="font-family: Georgia, serif; color: var(--color-text);">
        א
      </span>
    </div>
  </section>

  <!-- ============================================
       FEATURED PRODUCTS
       ============================================ -->
  <section class="py-20 md:py-28" style="background-color: var(--color-surface);" id="featured">
    <div class="container-wide">
      <!-- Section header -->
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 fade-in-up">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold" style="color: var(--color-text);">Featured Products</h2>
          <p class="mt-3 text-base" style="color: var(--color-text-muted);">Our most popular fonts and scripts</p>
        </div>
        <a href="/SHLEMUT/shop/" class="text-sm font-semibold no-underline flex items-center gap-2 transition-opacity hover:opacity-70" style="color: var(--color-accent);">
          View All
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Category filter pills -->
      <div class="flex gap-2 mb-10 fade-in-up" id="home-filters">
        <button class="filter-pill active btn text-xs px-4 py-2 rounded-full" data-filter="all" type="button">All</button>
        <button class="filter-pill btn text-xs px-4 py-2 rounded-full" data-filter="font" type="button">Fonts</button>
        <button class="filter-pill btn text-xs px-4 py-2 rounded-full" data-filter="script" type="button">Scripts</button>
      </div>

      <!-- Product grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="featured-grid">
        {featuredProducts.map((product) => (
          <div class="fade-in-up product-item" data-type={product.data.type}>
            <ProductCard
              slug={product.data.slug}
              title={product.data.title}
              type={product.data.type}
              price={product.data.price}
              currency={product.data.currency}
              thumbnail={product.data.thumbnail}
              category={product.data.category}
            />
          </div>
        ))}
        {/* Show all products if less than 4 featured */}
        {featuredProducts.length < 4 && allProducts.filter(p => !p.data.featured).map((product) => (
          <div class="fade-in-up product-item" data-type={product.data.type}>
            <ProductCard
              slug={product.data.slug}
              title={product.data.title}
              type={product.data.type}
              price={product.data.price}
              currency={product.data.currency}
              thumbnail={product.data.thumbnail}
              category={product.data.category}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================
       TRUST / FEATURES SECTION
       ============================================ -->
  <section class="py-20 md:py-28">
    <div class="container-wide">
      <div class="text-center mb-16 fade-in-up">
        <h2 class="text-3xl md:text-4xl font-bold" style="color: var(--color-text);">Why Designers Choose Us</h2>
        <p class="mt-3 text-base max-w-xl mx-auto" style="color: var(--color-text-muted);">
          Quality, reliability, and attention to detail in every product.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="text-center p-8 rounded-xl fade-in-up" style="background-color: var(--color-surface-alt);">
          <div class="w-12 h-12 mx-auto mb-5 rounded-full flex items-center justify-center" style="background-color: var(--color-accent-light);">
            <svg class="w-6 h-6" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2" style="color: var(--color-text);">Professional Quality</h3>
          <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.7;">
            Every font is hinted, kerned, and tested across platforms. Every script is production-ready.
          </p>
        </div>

        <!-- Feature 2 -->
        <div class="text-center p-8 rounded-xl fade-in-up" style="background-color: var(--color-surface-alt);">
          <div class="w-12 h-12 mx-auto mb-5 rounded-full flex items-center justify-center" style="background-color: var(--color-accent-light);">
            <svg class="w-6 h-6" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2" style="color: var(--color-text);">Instant Delivery</h3>
          <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.7;">
            Download links and serial keys delivered to your inbox within seconds of purchase.
          </p>
        </div>

        <!-- Feature 3 -->
        <div class="text-center p-8 rounded-xl fade-in-up" style="background-color: var(--color-surface-alt);">
          <div class="w-12 h-12 mx-auto mb-5 rounded-full flex items-center justify-center" style="background-color: var(--color-accent-light);">
            <svg class="w-6 h-6" style="color: var(--color-accent);" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold mb-2" style="color: var(--color-text);">Made with Care</h3>
          <p class="text-sm" style="color: var(--color-text-muted); line-height: 1.7;">
            Built by designers who understand what it takes to create exceptional work.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================
       TESTIMONIALS
       ============================================ -->
  <section class="py-20 md:py-28" style="background-color: var(--color-surface);">
    <div class="container-wide">
      <div class="text-center mb-16 fade-in-up">
        <h2 class="text-3xl md:text-4xl font-bold" style="color: var(--color-text);">What Designers Say</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <blockquote class="p-8 rounded-xl fade-in-up" style="border: 1px solid var(--color-border);">
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4" style="color: var(--color-accent);" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text);">
            "Aleph Pro is the Hebrew font I've been waiting for. The weight range and Latin harmony are exceptional."
          </p>
          <footer>
            <p class="text-sm font-semibold" style="color: var(--color-text);">Maya Cohen</p>
            <p class="text-xs" style="color: var(--color-text-muted);">Brand Designer, Tel Aviv</p>
          </footer>
        </blockquote>

        <blockquote class="p-8 rounded-xl fade-in-up" style="border: 1px solid var(--color-border);">
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4" style="color: var(--color-accent);" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text);">
            "TableMaster Pro saved me hours on a 200-page annual report. The batch formatting is a game-changer."
          </p>
          <footer>
            <p class="text-sm font-semibold" style="color: var(--color-text);">David Park</p>
            <p class="text-xs" style="color: var(--color-text-muted);">Production Designer, NYC</p>
          </footer>
        </blockquote>

        <blockquote class="p-8 rounded-xl fade-in-up" style="border: 1px solid var(--color-border);">
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-4 h-4" style="color: var(--color-accent);" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-sm leading-relaxed mb-4" style="color: var(--color-text);">
            "Clean, professional products with excellent documentation. SHLEMUT is now my go-to for InDesign tools."
          </p>
          <footer>
            <p class="text-sm font-semibold" style="color: var(--color-text);">Anna Müller</p>
            <p class="text-xs" style="color: var(--color-text-muted);">Art Director, Berlin</p>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  <!-- ============================================
       NEWSLETTER CTA
       ============================================ -->
  <section class="py-20 md:py-28">
    <div class="container-narrow text-center fade-in-up">
      <h2 class="text-3xl md:text-4xl font-bold mb-4" style="color: var(--color-text);">Stay in the Loop</h2>
      <p class="text-base mb-8 max-w-lg mx-auto" style="color: var(--color-text-muted);">
        Be the first to know about new releases, special offers, and design tips.
      </p>
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto" action="#" method="post">
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="flex-1 px-5 py-3 text-sm rounded-lg outline-none transition-colors duration-150"
          style="background-color: var(--color-surface-alt); border: 1px solid var(--color-border); color: var(--color-text);"
          aria-label="Email address"
        />
        <button type="submit" class="btn btn-primary px-6 py-3">Subscribe</button>
      </form>
      <p class="text-xs mt-4" style="color: var(--color-text-muted);">No spam, ever. Unsubscribe at any time.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .filter-pill {
    background-color: transparent;
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
  .filter-pill:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }
  .filter-pill.active {
    background-color: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }
  :global(.dark) .filter-pill.active {
    background-color: var(--color-text-dark);
    color: var(--color-bg-dark);
    border-color: var(--color-text-dark);
  }
</style>

<script>
  // Hero word rotation
  const words = ['Scripts', 'Tools', 'Assets', 'Scripts'];
  let wordIndex = 0;
  const heroWord = document.getElementById('hero-word');

  setInterval(() => {
    if (!heroWord) return;
    heroWord.style.opacity = '0';
    heroWord.style.transform = 'translateY(10px)';
    setTimeout(() => {
      wordIndex = (wordIndex + 1) % words.length;
      heroWord.textContent = words[wordIndex];
      heroWord.style.opacity = '1';
      heroWord.style.transform = 'translateY(0)';
    }, 300);
  }, 3000);

  // Category filtering
  const filterBtns = document.querySelectorAll('#home-filters .filter-pill');
  const productItems = document.querySelectorAll('#featured-grid .product-item');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      productItems.forEach((item) => {
        const type = (item as HTMLElement).dataset.type;
        if (filter === 'all' || type === filter) {
          (item as HTMLElement).style.display = '';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
