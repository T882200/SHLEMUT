---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products', ({ data }) => data.status === 'published');

// Get unique categories and tags for filters
const categories = [...new Set(allProducts.map((p) => p.data.category))];
const types = ['font', 'script'] as const;
const allTags = [...new Set(allProducts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title="Shop" description="Browse our collection of premium fonts and InDesign scripts.">
  <section class="py-12 md:py-20">
    <div class="container-wide">
      <!-- Page header -->
      <div class="mb-12 fade-in-up">
        <h1 class="text-4xl md:text-5xl font-bold gradient-text">Shop</h1>
        <p class="mt-3 text-lg" style="color: var(--color-text-muted);">
          Browse our collection of premium digital assets.
        </p>
      </div>

      <div class="flex flex-col lg:flex-row gap-10">
        <!-- Sidebar filters -->
        <aside class="lg:w-64 flex-shrink-0 fade-in-up">
          <div class="lg:sticky lg:top-24 space-y-8">
            <!-- Type filter -->
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--color-text-muted);">Type</h3>
              <div class="flex flex-wrap lg:flex-col gap-2">
                <button class="type-filter active text-left text-sm px-3 py-1.5 rounded-md transition-colors duration-150" data-type="all" type="button">
                  All Products
                </button>
                {types.map((t) => (
                  <button class="type-filter text-left text-sm px-3 py-1.5 rounded-md transition-colors duration-150 capitalize" data-type={t} type="button">
                    {t}s
                  </button>
                ))}
              </div>
            </div>

            <!-- Category filter -->
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--color-text-muted);">Category</h3>
              <div class="flex flex-wrap lg:flex-col gap-2">
                <button class="cat-filter active text-left text-sm px-3 py-1.5 rounded-md transition-colors duration-150" data-cat="all" type="button">
                  All
                </button>
                {categories.map((c) => (
                  <button class="cat-filter text-left text-sm px-3 py-1.5 rounded-md transition-colors duration-150" data-cat={c} type="button">
                    {c}
                  </button>
                ))}
              </div>
            </div>

            <!-- Tags -->
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--color-text-muted);">Tags</h3>
              <div class="flex flex-wrap gap-2" id="tag-filters">
                {allTags.map((tag) => (
                  <button
                    class="tag-filter text-xs px-2.5 py-1 rounded-full transition-colors duration-150"
                    style="border: 1px solid var(--color-border); color: var(--color-text-muted);"
                    data-tag={tag}
                    type="button"
                  >
                    {tag}
                  </button>
                ))}
              </div>
            </div>

            <!-- Sort -->
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wider mb-3" style="color: var(--color-text-muted);">Sort By</h3>
              <select
                id="sort-select"
                class="w-full text-sm px-3 py-2 rounded-md appearance-none cursor-pointer"
                style="background-color: var(--color-surface-alt); border: 1px solid var(--color-border); color: var(--color-text);"
              >
                <option value="newest">Newest First</option>
                <option value="price-low">Price: Low to High</option>
                <option value="price-high">Price: High to Low</option>
                <option value="name">Name: A to Z</option>
              </select>
            </div>
          </div>
        </aside>

        <!-- Product grid -->
        <div class="flex-1">
          <!-- Results count -->
          <div class="flex items-center justify-between mb-6">
            <p id="results-count" class="text-sm" style="color: var(--color-text-muted);">
              {allProducts.length} products
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6" id="shop-grid">
            {allProducts.map((product) => (
              <div
                class="shop-product fade-in-up"
                data-type={product.data.type}
                data-category={product.data.category}
                data-tags={product.data.tags.join(',')}
                data-price={product.data.price}
                data-date={product.data.date.toISOString()}
                data-name={product.data.title}
              >
                <ProductCard
                  slug={product.data.slug}
                  title={product.data.title}
                  type={product.data.type}
                  price={product.data.price}
                  currency={product.data.currency}
                  thumbnail={product.data.thumbnail}
                  category={product.data.category}
                />
              </div>
            ))}
          </div>

          <!-- Empty state -->
          <div id="shop-empty" class="hidden text-center py-20">
            <p class="text-lg font-medium" style="color: var(--color-text-muted);">No products match your filters.</p>
            <button id="clear-filters" class="btn btn-secondary mt-4 text-sm" type="button">Clear Filters</button>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .type-filter, .cat-filter {
    color: var(--color-text-muted);
  }
  .type-filter:hover, .cat-filter:hover {
    background-color: var(--color-surface-alt);
    color: var(--color-text);
  }
  .type-filter.active, .cat-filter.active {
    background-color: var(--color-surface-alt);
    color: var(--color-text);
    font-weight: 600;
  }
  .tag-filter.active {
    background: linear-gradient(135deg, var(--color-pink), var(--color-purple)) !important;
    color: white !important;
    border-color: transparent !important;
  }
  :global(.dark) .tag-filter.active {
    background: linear-gradient(135deg, #F59E0B, #D97706) !important;
    color: #0A0A0A !important;
  }
</style>

<script>
  const grid = document.getElementById('shop-grid');
  const emptyState = document.getElementById('shop-empty');
  const resultsCount = document.getElementById('results-count');
  const products = document.querySelectorAll('.shop-product');

  let activeType = 'all';
  let activeCat = 'all';
  let activeTags: string[] = [];
  let activeSort = 'newest';

  function filterAndSort() {
    let visible = 0;
    const items = Array.from(products) as HTMLElement[];

    items.forEach((item) => {
      const type = item.dataset.type;
      const cat = item.dataset.category;
      const tags = (item.dataset.tags || '').split(',');

      const typeMatch = activeType === 'all' || type === activeType;
      const catMatch = activeCat === 'all' || cat === activeCat;
      const tagMatch = activeTags.length === 0 || activeTags.some((t) => tags.includes(t));

      if (typeMatch && catMatch && tagMatch) {
        item.style.display = '';
        visible++;
      } else {
        item.style.display = 'none';
      }
    });

    // Sort visible items
    const visibleItems = items.filter((i) => i.style.display !== 'none');
    visibleItems.sort((a, b) => {
      switch (activeSort) {
        case 'price-low':
          return Number(a.dataset.price) - Number(b.dataset.price);
        case 'price-high':
          return Number(b.dataset.price) - Number(a.dataset.price);
        case 'name':
          return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        case 'newest':
        default:
          return new Date(b.dataset.date || '').getTime() - new Date(a.dataset.date || '').getTime();
      }
    });

    // Re-order in DOM
    visibleItems.forEach((item) => grid?.appendChild(item));

    // Update UI
    if (resultsCount) {
      resultsCount.textContent = `${visible} product${visible !== 1 ? 's' : ''}`;
    }
    emptyState?.classList.toggle('hidden', visible > 0);
    grid?.classList.toggle('hidden', visible === 0);
  }

  // Type filters
  document.querySelectorAll('.type-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.type-filter').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeType = (btn as HTMLElement).dataset.type || 'all';
      filterAndSort();
    });
  });

  // Category filters
  document.querySelectorAll('.cat-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.cat-filter').forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = (btn as HTMLElement).dataset.cat || 'all';
      filterAndSort();
    });
  });

  // Tag filters (toggle)
  document.querySelectorAll('.tag-filter').forEach((btn) => {
    btn.addEventListener('click', () => {
      const tag = (btn as HTMLElement).dataset.tag || '';
      btn.classList.toggle('active');
      if (activeTags.includes(tag)) {
        activeTags = activeTags.filter((t) => t !== tag);
      } else {
        activeTags.push(tag);
      }
      filterAndSort();
    });
  });

  // Sort
  document.getElementById('sort-select')?.addEventListener('change', (e) => {
    activeSort = (e.target as HTMLSelectElement).value;
    filterAndSort();
  });

  // Clear filters
  document.getElementById('clear-filters')?.addEventListener('click', () => {
    activeType = 'all';
    activeCat = 'all';
    activeTags = [];
    activeSort = 'newest';
    document.querySelectorAll('.type-filter, .cat-filter, .tag-filter').forEach((b) => b.classList.remove('active'));
    document.querySelector('.type-filter[data-type="all"]')?.classList.add('active');
    document.querySelector('.cat-filter[data-cat="all"]')?.classList.add('active');
    (document.getElementById('sort-select') as HTMLSelectElement).value = 'newest';
    filterAndSort();
  });

  // Apply URL params on load
  const params = new URLSearchParams(window.location.search);
  const urlType = params.get('type');
  if (urlType && (urlType === 'font' || urlType === 'script')) {
    activeType = urlType;
    document.querySelectorAll('.type-filter').forEach((b) => b.classList.remove('active'));
    document.querySelector(`.type-filter[data-type="${urlType}"]`)?.classList.add('active');
    filterAndSort();
  }
</script>
