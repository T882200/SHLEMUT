---
/**
 * Slide-out cart drawer. Toggled by the cart icon in the header.
 * All cart logic runs client-side.
 *
 * Design system:
 *   Light — white bg, pink-purple-blue accents, black text
 *   Dark  — pure black bg, yellow-orange (#F59E0B) accents, white text
 */
---

<style>
  /* ---------- Overlay ---------- */
  .cart-overlay {
    position: fixed;
    inset: 0;
    z-index: 30;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity var(--duration-normal, 250ms) var(--ease-out, ease);
    pointer-events: none;
  }
  .cart-overlay.is-visible {
    opacity: 1;
    pointer-events: auto;
  }

  /* ---------- Drawer ---------- */
  .cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 40;
    height: 100%;
    width: 100%;
    max-width: 28rem; /* max-w-md */
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--duration-normal, 250ms) var(--ease-out, ease);
    background-color: var(--color-surface);
    border-left: 1px solid var(--color-border);
  }
  :global(.dark) .cart-drawer {
    background-color: var(--color-surface-dark);
    border-left-color: var(--color-border-dark);
  }
  .cart-drawer.is-open {
    transform: translateX(0);
  }

  /* ---------- Header ---------- */
  .cart-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem;
    border-bottom: 1px solid var(--color-border);
  }
  :global(.dark) .cart-header {
    border-bottom-color: var(--color-border-dark);
  }
  .cart-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
  }
  :global(.dark) .cart-title {
    color: var(--color-text-dark);
  }
  .cart-close-btn {
    padding: 0.5rem;
    border-radius: var(--radius-lg, 0.75rem);
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--duration-fast, 150ms), background-color var(--duration-fast, 150ms);
  }
  .cart-close-btn:hover {
    color: var(--color-text);
    background-color: var(--color-surface-alt);
  }
  :global(.dark) .cart-close-btn {
    color: var(--color-text-muted-dark);
  }
  :global(.dark) .cart-close-btn:hover {
    color: var(--color-text-dark);
    background-color: var(--color-surface-alt-dark);
  }

  /* ---------- Body / Items ---------- */
  .cart-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
  }

  /* Empty state */
  .cart-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-align: center;
  }
  .cart-empty-icon {
    width: 4rem;
    height: 4rem;
    margin-bottom: 1rem;
    color: var(--color-border);
  }
  :global(.dark) .cart-empty-icon {
    color: var(--color-border-dark);
  }
  .cart-empty-msg {
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    color: var(--color-text-muted);
  }
  :global(.dark) .cart-empty-msg {
    color: var(--color-text-muted-dark);
  }

  /* Item list */
  .cart-item-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Single item */
  .cart-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .cart-item-thumb {
    width: 4rem;
    height: 4rem;
    border-radius: var(--radius-lg, 0.75rem);
    flex-shrink: 0;
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }
  :global(.dark) .cart-item-thumb {
    background-color: var(--color-surface-alt-dark);
  }
  .cart-item-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cart-item-info {
    flex: 1;
    min-width: 0;
  }
  .cart-item-title {
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-text);
  }
  :global(.dark) .cart-item-title {
    color: var(--color-text-dark);
  }
  .cart-item-meta {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }
  .cart-item-price {
    font-size: var(--text-sm, 0.875rem);
    font-weight: 600;
    color: var(--color-text);
  }
  :global(.dark) .cart-item-price {
    color: var(--color-text-dark);
  }
  .cart-remove-btn {
    font-size: var(--text-xs, 0.75rem);
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: opacity var(--duration-fast, 150ms);
  }
  .cart-remove-btn:hover {
    opacity: 0.7;
  }
  :global(.dark) .cart-remove-btn {
    color: var(--color-text-muted-dark);
  }

  /* ---------- Footer ---------- */
  .cart-footer {
    padding: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  :global(.dark) .cart-footer {
    border-top-color: var(--color-border-dark);
  }
  .cart-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .cart-footer-label {
    font-size: var(--text-sm, 0.875rem);
    font-weight: 500;
    color: var(--color-text-muted);
  }
  :global(.dark) .cart-footer-label {
    color: var(--color-text-muted-dark);
  }
  .cart-footer-total {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }
  :global(.dark) .cart-footer-total {
    color: var(--color-text-dark);
  }
  .cart-footer-note {
    font-size: var(--text-xs, 0.75rem);
    text-align: center;
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }
  :global(.dark) .cart-footer-note {
    color: var(--color-text-muted-dark);
  }

  /* Utility: hidden helper */
  .is-hidden {
    display: none !important;
  }
</style>

<!-- Overlay -->
<div
  id="cart-overlay"
  class="cart-overlay"
  aria-hidden="true"
></div>

<!-- Drawer -->
<aside
  id="cart-drawer"
  class="cart-drawer"
  role="dialog"
  aria-label="Shopping cart"
  aria-hidden="true"
>
  <!-- Header -->
  <div class="cart-header">
    <h2 class="cart-title">Cart</h2>
    <button
      id="cart-close"
      class="cart-close-btn"
      aria-label="Close cart"
      type="button"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Cart items -->
  <div id="cart-items" class="cart-body">
    <!-- Empty state -->
    <div id="cart-empty" class="cart-empty">
      <svg class="cart-empty-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <p class="cart-empty-msg">Your cart is empty</p>
      <a href="/SHLEMUT/shop/" class="btn btn-secondary mt-4 text-sm">Browse Products</a>
    </div>
    <!-- Items rendered here by JS -->
    <div id="cart-item-list" class="cart-item-list is-hidden"></div>
  </div>

  <!-- Footer with total and checkout -->
  <div id="cart-footer" class="cart-footer is-hidden">
    <div class="cart-footer-row">
      <span class="cart-footer-label">Total</span>
      <span id="cart-total" class="cart-footer-total">$0</span>
    </div>
    <button id="checkout-btn" class="btn btn-gradient w-full" type="button">
      Checkout
    </button>
    <p class="cart-footer-note">
      You'll be redirected to our secure payment provider.
    </p>
  </div>
</aside>

<script>
  const overlay = document.getElementById('cart-overlay');
  const drawer = document.getElementById('cart-drawer');
  const cartEmpty = document.getElementById('cart-empty');
  const cartItemList = document.getElementById('cart-item-list');
  const cartFooter = document.getElementById('cart-footer');
  const cartTotal = document.getElementById('cart-total');

  function openCart() {
    overlay?.classList.add('is-visible');
    drawer?.classList.add('is-open');
    drawer?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    renderCart();
  }

  function closeCart() {
    overlay?.classList.remove('is-visible');
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  function formatPrice(price: number): string {
    return new Intl.NumberFormat('en-US', {
      style: 'currency',
      currency: 'USD',
      minimumFractionDigits: 0,
    }).format(price);
  }

  function renderCart() {
    let cart: Array<{slug: string; title: string; price: number; thumbnail: string; type: string}> = [];
    try {
      cart = JSON.parse(localStorage.getItem('shlemut-cart') || '[]');
    } catch { /* empty */ }

    if (cart.length === 0) {
      cartEmpty?.classList.remove('is-hidden');
      cartItemList?.classList.add('is-hidden');
      cartFooter?.classList.add('is-hidden');
      return;
    }

    cartEmpty?.classList.add('is-hidden');
    cartItemList?.classList.remove('is-hidden');
    cartFooter?.classList.remove('is-hidden');

    const total = cart.reduce((sum: number, item: {price: number}) => sum + item.price, 0);
    if (cartTotal) cartTotal.textContent = formatPrice(total);

    if (cartItemList) {
      cartItemList.innerHTML = cart
        .map(
          (item) => `
        <div class="cart-item" data-slug="${item.slug}">
          <div class="cart-item-thumb">
            <img src="${item.thumbnail}" alt="${item.title}" loading="lazy" />
          </div>
          <div class="cart-item-info">
            <h4 class="cart-item-title">${item.title}</h4>
            <span class="badge mt-1">${item.type}</span>
          </div>
          <div class="cart-item-meta">
            <span class="cart-item-price">${formatPrice(item.price)}</span>
            <button class="cart-remove-btn" data-slug="${item.slug}" aria-label="Remove ${item.title}">Remove</button>
          </div>
        </div>
      `,
        )
        .join('');

      // Attach remove handlers
      cartItemList.querySelectorAll('.cart-remove-btn').forEach((btn) => {
        btn.addEventListener('click', () => {
          const slug = (btn as HTMLElement).dataset.slug;
          let c: Array<{slug: string}> = [];
          try { c = JSON.parse(localStorage.getItem('shlemut-cart') || '[]'); } catch { /* empty */ }
          const updated = c.filter((i: {slug: string}) => i.slug !== slug);
          localStorage.setItem('shlemut-cart', JSON.stringify(updated));
          window.dispatchEvent(new CustomEvent('cart-updated', { detail: { items: updated } }));
          renderCart();
        });
      });
    }
  }

  // Event listeners
  window.addEventListener('toggle-cart', openCart);
  overlay?.addEventListener('click', closeCart);
  document.getElementById('cart-close')?.addEventListener('click', closeCart);

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer?.classList.contains('is-open')) {
      closeCart();
    }
  });

  // Re-render when cart updates
  window.addEventListener('cart-updated', renderCart);
</script>
