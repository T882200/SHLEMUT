---
/**
 * Site footer with links, social icons, and newsletter form.
 */
const currentYear = new Date().getFullYear();
---

<footer style="background-color: var(--color-surface); border-top: 1px solid var(--color-border);" class="dark:bg-[var(--color-surface-dark)] dark:border-[var(--color-border-dark)]">
  <div class="container-wide py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/SHLEMUT/" class="text-2xl font-bold tracking-tight no-underline" style="color: var(--color-text); font-family: var(--font-heading);">
          SHLEMUT
        </a>
        <p class="mt-4 max-w-md" style="color: var(--color-text-muted); font-size: var(--text-sm); line-height: 1.7;">
          Premium digital assets for designers and typographers. Carefully crafted fonts
          and InDesign scripts to elevate your creative workflow.
        </p>
        <!-- Social links -->
        <div class="flex gap-4 mt-6">
          <a href="#" class="transition-opacity hover:opacity-70" style="color: var(--color-text-muted);" aria-label="Twitter">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="#" class="transition-opacity hover:opacity-70" style="color: var(--color-text-muted);" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="transition-opacity hover:opacity-70" style="color: var(--color-text-muted);" aria-label="GitHub">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: var(--color-text);">Shop</h3>
        <ul class="space-y-3">
          <li><a href="/SHLEMUT/shop/" class="text-sm no-underline transition-opacity hover:opacity-70" style="color: var(--color-text-muted);">All Products</a></li>
          <li><a href="/SHLEMUT/shop/?type=font" class="text-sm no-underline transition-opacity hover:opacity-70" style="color: var(--color-text-muted);">Fonts</a></li>
          <li><a href="/SHLEMUT/shop/?type=script" class="text-sm no-underline transition-opacity hover:opacity-70" style="color: var(--color-text-muted);">Scripts</a></li>
          <li><a href="/SHLEMUT/license/" class="text-sm no-underline transition-opacity hover:opacity-70" style="color: var(--color-text-muted);">License Terms</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider mb-4" style="color: var(--color-text);">Stay Updated</h3>
        <p class="text-sm mb-4" style="color: var(--color-text-muted);">
          Get notified about new releases and special offers.
        </p>
        <form id="newsletter-form" class="flex flex-col gap-3" action="#" method="post">
          <input
            type="email"
            name="email"
            placeholder="your@email.com"
            required
            class="w-full px-4 py-2.5 text-sm rounded-lg outline-none transition-colors duration-150"
            style="background-color: var(--color-surface-alt); border: 1px solid var(--color-border); color: var(--color-text);"
            aria-label="Email address"
          />
          <button type="submit" class="btn btn-primary text-sm">
            Subscribe
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-16 pt-8 flex flex-col md:flex-row items-center justify-between gap-4" style="border-top: 1px solid var(--color-border);">
      <p class="text-xs" style="color: var(--color-text-muted);">
        &copy; {currentYear} SHLEMUT. All rights reserved.
      </p>
      <div class="flex gap-6">
        <a href="/SHLEMUT/license/" class="text-xs no-underline transition-opacity hover:opacity-70" style="color: var(--color-text-muted);">License</a>
        <a href="/SHLEMUT/faq/" class="text-xs no-underline transition-opacity hover:opacity-70" style="color: var(--color-text-muted);">Support</a>
      </div>
    </div>
  </div>
</footer>
